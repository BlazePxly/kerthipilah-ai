# Salin menjadi .env.local lalu isi nilainya. JANGAN commit file .env.local.

# --- Penyedia AI (OpenAI-compatible, default: DeepSeek) ---
AI_BASE_URL=            # mis. https://contoh-endpoint/v1
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash                  # model teks (Tanya Pilah, ringkasan)
AI_VISION_MODEL=deepseek-v4-flash-vision-exp  # model vision (Cek Sampah, Audit Wadah)

# Alternatif: Anthropic Claude (dipakai bila AI_BASE_URL kosong)
ANTHROPIC_API_KEY=

# --- Login akun demo petugas/pengelola ---
AUTH_SECRET=        # string acak minimal 32 karakter
DEMO_USERNAME=
DEMO_PASSWORD=

# --- Opsional: PostgreSQL (Neon). Kosong = file JSON lokal (hanya untuk pengembangan) ---
DATABASE_URL=
